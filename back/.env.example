# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.cxyuxuz.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Token Secrets (Generate secure random 32+ character strings)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here_32_characters_min
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here_32_characters_min

# Frontend URLs for CORS & Redirects (comma-separated if multiple)
